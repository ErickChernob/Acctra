# ACCTRA - Apache configuration for the independent static site.
# Safe to place at the web root (public_html) as-is.

# ---------------------------------------------------------------------------
# 1. Force HTTPS and a single canonical host (www.acctra.com.mx)
#    Adjust the host below if the production domain differs from what's
#    already referenced throughout this project (canonical tags, sitemap.xml,
#    robots.txt all use https://www.acctra.com.mx).
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # non-www -> www
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ---------------------------------------------------------------------------
  # 2. Clean URLs: allow "/quienes-somos" to serve "/quienes-somos.html".
  #    Webflow's own hosting always serves pages without the ".html"
  #    extension, so this keeps any previously indexed/bookmarked clean URLs
  #    working. Every page's <link rel="canonical"> currently points at the
  #    explicit ".html" URL (matching this project's internal links); if the
  #    live Webflow site turns out to have been indexed under the clean URLs
  #    instead, flip the canonical tags (and optionally add a redirect here)
  #    to match - this could not be verified from the environment this
  #    migration was performed in. See MIGRATION_NOTES.md.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [NC,L]
</IfModule>

DirectoryIndex index.html

# ---------------------------------------------------------------------------
# 3. Custom error pages
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 401 /401.html

# ---------------------------------------------------------------------------
# 4. Prevent directory listing
# ---------------------------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------------------------
# 5. Legacy Webflow paths
#    No differing legacy URL structure was identified during this migration
#    (every page slug already matches its original Webflow page). If Google
#    Search Console or site analytics later surface indexed URLs that don't
#    match a file in this project, add explicit Redirect 301 rules here.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 6. Sensible defaults
# ---------------------------------------------------------------------------
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|svg|jpg|jpeg|png|gif|webp|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
